# Valores de desarrollo sin secretos. Cree un .env local únicamente en su entorno.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_LOG_LEVEL=info
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Base local persistente de EMPRE.IA
EMPRE_DB_PATH=.data/empreia.sqlite


# Mercado Pago — SOLO backend / servidor. Nunca publiques el Access Token en el frontend.
# Link manual de respaldo (no activa planes automáticamente).
# Link público de respaldo (opcional). No sustituye el checkout integrado.
MERCADOPAGO_PAYMENT_LINK=
MERCADOPAGO_ACCESS_TOKEN=
# test o production. No se infiere desde el prefijo del token.
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_WEBHOOK_SECRET=
EMPRE_PUBLIC_WEB_URL=http://localhost:3000

# IA real — SOLO backend / servidor.
OPENAI_API_KEY=
EMPRE_AI_MODEL=gpt-6-astra
EMPRE_AI_MODEL_BASIC=gpt-6-astra
EMPRE_AI_MODEL_PRO=gpt-6-astra
# Búsqueda web de EMPRE.IA. true = Internet en vivo; false = desactivada.
EMPRE_WEB_SEARCH_ENABLED=true
# Orígenes web permitidos por CORS en la API. En producción pon aquí tu dominio real.
EMPRE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cifrado de credenciales de Connectors: 32 bytes en hex o base64.
# En desarrollo, si se deja vacío, EMPRE genera .data/.connector-key.
EMPRE_CONNECTOR_ENCRYPTION_KEY=

# Sólo desarrollo/local. En producción mantenlo false y usa un endpoint HTTPS público.
EMPRE_CONNECTOR_ALLOW_PRIVATE_NETWORK=false

# Public/production
# In Railway production, set EMPRE_DB_PATH=/data/empreia.sqlite and attach a persistent Volume at /data.
EMPRE_PUBLIC_WEB_URL=http://localhost:3000
EMPRE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI
OPENAI_API_KEY=
EMPRE_AI_MODEL=gpt-6-astra
EMPRE_AI_MODEL_BASIC=gpt-6-astra
EMPRE_AI_MODEL_PRO=gpt-6-astra
EMPRE_WEB_SEARCH_ENABLED=true

# Platform owner — used only on first startup when platform_admins is empty.
# Never commit real values. Store them as Railway/Vercel server secrets.
EMPRE_PLATFORM_ADMIN_NAME=Propietario EMPRE.IA
EMPRE_PLATFORM_ADMIN_EMAIL=
EMPRE_PLATFORM_ADMIN_PASSWORD=

# Mercado Pago production secrets stay on the API server only.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_PAYMENT_LINK=https://link.mercadopago.com.co/juanvidal
